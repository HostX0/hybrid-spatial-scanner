{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hss:command-result.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "command_id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "type": "string",
      "enum": [
        "applied",
        "rejected",
        "conflict",
        "superseded"
      ]
    },
    "scene_revision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Canonical uint64 decimal; additionally reject values above 18446744073709551615."
    },
    "issue_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "minItems": 0
    },
    "conflict_constraint_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "minItems": 0
    },
    "diagnostic": {
      "type": "string",
      "minLength": 1
    },
    "durability": {
      "type": "string",
      "enum": [
        "not_committed",
        "committed"
      ]
    },
    "journal_commit_id": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "command_id",
    "state",
    "scene_revision",
    "issue_ids",
    "conflict_constraint_ids",
    "diagnostic",
    "durability",
    "journal_commit_id"
  ],
  "additionalProperties": false
}
