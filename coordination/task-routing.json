  "policy": {
    "review_policy": "Focused tests once per change; brief integration check using actual evidence; one batch review/smoke per real runnable milestone. Additional review only for a documented concrete defect, uncovered critical risk, contract change or merge conflict; never automatically per task.",
    "max_active_engineering_tasks": null,
    "parallelism": "No owner-imposed count cap. Dispatch dependency-ready independent tasks within actual host/tool capacity, exclusive ownership and review throughput; avoid duplicate/speculative work.",
    "environment": "Xcode27.0(27A266a), Swift6.4, isolated Python3.12.14/CMake3.31.6; owner final-tests iPhone15 Pro Max",
    "states": {
      "implemented_reviewed": "code + relevant host/native checks + coordinator review",
      "done_accepted": "source acceptance evidence at its required layer; hardware evidence cannot be simulated"
    },
    "acceptance_dependency_rule": "acceptance_depends_on preserves the source B graph; a task is Done only after those predecessors are Done.",
    "implementation_dependency_rule": "implementation_depends_on requires reviewed contracts/code, and permits hardware-independent work with assumptions recorded; it never upgrades a physical gate.",
    "astra": "Use when specific core complexity or an unresolved defect genuinely warrants it; record the justification. A failed cheaper attempt is not required when complexity already establishes the need.",
    "optional_cloud": "B-050 disabled; do not schedule or make it a dependency",
    "model_ids": {
      "luna": "gpt-5.6-luna",
      "terra": "gpt-5.6-terra",
